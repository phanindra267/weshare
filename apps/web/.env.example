# Base URL of the WeShare Go API (no trailing slash).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# WebSocket origin for realtime events (no trailing slash).
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# JS-readable CSRF cookie set by the API (must match the API's
# CSRF_COOKIE_NAME). The client echoes its value in X-CSRF-Token on
# state-changing requests.
NEXT_PUBLIC_CSRF_COOKIE_NAME=weshare_csrf

# WeShare API configuration (development).
# Copy to `.env` in this directory. Never commit real secrets.

# development | test | production
APP_ENV=development

HTTP_ADDR=:8080

# PostgreSQL connection string. Must match infra/.env credentials.
# Port 5433 avoids conflicts with other local PostgreSQL instances; if you
# change POSTGRES_PORT in infra/.env, update the port here to match.
DATABASE_URL=postgres://weshare:weshare@localhost:5433/weshare?sslmode=disable

# Apply pending migrations automatically at startup (convenient in dev).
AUTO_MIGRATE=true

# Comma-separated list of browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Comma-separated proxy CIDRs/IPs whose X-Forwarded-For may be trusted for the
# client IP (logging, rate limiting). Leave EMPTY unless running behind a proxy
# we control: trusting it lets any client spoof their IP and bypass rate limits.
TRUSTED_PROXIES=

# --- Auth: session cookies ---------------------------------------------
# HTTP-only cookie carrying the opaque session token.
SESSION_COOKIE_NAME=weshare_session
# JS-readable cookie the frontend echoes in the X-CSRF-Token header.
CSRF_COOKIE_NAME=weshare_csrf
# Enforce double-submit CSRF on unsafe methods when a session cookie exists.
CSRF_ENABLED=true
# Session lifetime.
SESSION_TTL=168h
# lax | strict | none ("none" requires COOKIE_SECURE=true).
COOKIE_SAMESITE=lax
COOKIE_PATH=/
# Defaults to false in development, true in production.
# COOKIE_SECURE=false

# --- Auth: login policy -------------------------------------------------
# Failed attempts before an account is locked.
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15m
MIN_PASSWORD_LENGTH=8

# --- Auth: media storage ------------------------------------------------
# Where uploaded avatars are written on the local filesystem.
STORAGE_DIR=./storage
# Maximum accepted avatar upload size in bytes (2 MB).
MAX_AVATAR_BYTES=2097152

# --- Presence -----------------------------------------------------------
# A user counts as online until this long after their last heartbeat.
PRESENCE_STALE_AFTER=60s

LOG_LEVEL=info
LOG_FORMAT=text
